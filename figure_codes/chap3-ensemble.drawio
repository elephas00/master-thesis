<mxfile host="app.diagrams.net" agent="Cursor" version="24.0.0">
  <diagram name="异构集成预测" id="chap3-ensemble">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="异构集成预测结构示意图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- 输入特征 -->
        <mxCell id="input" value="&lt;b&gt;短期时序突变特征&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;z&lt;sub&gt;i,t&lt;/sub&gt; ∈ ℝ&lt;sup&gt;16W+9&lt;/sup&gt;&lt;br&gt;（Lag 特征 + B 组突变特征）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="190" height="110" as="geometry"/>
        </mxCell>

        <!-- 第一层容器 -->
        <mxCell id="layer1-box" value="第一层：异构基分类器" style="swimlane;html=1;startSize=30;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=12;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="110" width="300" height="365" as="geometry"/>
        </mxCell>

        <!-- 集合符号（swimlane 标题不支持 HTML，单独放置） -->
        <mxCell id="layer1-formula" value="&lt;font style=&quot;font-size:11px&quot;&gt;ℳ = {M&lt;sub&gt;m&lt;/sub&gt;}&lt;sub&gt;m=1&lt;/sub&gt;&lt;sup&gt;N&lt;/sup&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=0;" vertex="1" parent="layer1-box">
          <mxGeometry x="10" y="35" width="280" height="24" as="geometry"/>
        </mxCell>

        <!-- M_1 -->
        <mxCell id="m1" value="&lt;b&gt;M&lt;sub&gt;1&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;基分类器&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontSize=12;" vertex="1" parent="layer1-box">
          <mxGeometry x="30" y="68" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m1-out" value="p&lt;sub&gt;i,t&lt;/sub&gt;&lt;sup&gt;(1)&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="layer1-box">
          <mxGeometry x="190" y="73" width="80" height="50" as="geometry"/>
        </mxCell>

        <!-- 省略号 -->
        <mxCell id="dots1" value="&lt;font style=&quot;font-size:20px;color:#666666&quot;&gt;⋮&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" vertex="1" parent="layer1-box">
          <mxGeometry x="70" y="138" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="dots-mid" value="&lt;font style=&quot;font-size:10px;color:#888888&quot;&gt;M&lt;sub&gt;2&lt;/sub&gt;, …, M&lt;sub&gt;N−1&lt;/sub&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="layer1-box">
          <mxGeometry x="30" y="173" width="240" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="dots2" value="&lt;font style=&quot;font-size:20px;color:#666666&quot;&gt;⋮&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" vertex="1" parent="layer1-box">
          <mxGeometry x="70" y="198" width="40" height="40" as="geometry"/>
        </mxCell>

        <!-- M_N -->
        <mxCell id="mN" value="&lt;b&gt;M&lt;sub&gt;N&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;基分类器&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontSize=12;" vertex="1" parent="layer1-box">
          <mxGeometry x="30" y="248" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mN-out" value="p&lt;sub&gt;i,t&lt;/sub&gt;&lt;sup&gt;(N)&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="layer1-box">
          <mxGeometry x="190" y="253" width="80" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="layer1-note" value="&lt;font style=&quot;font-size:10px;color:#555555&quot;&gt;N ≥ 2；归纳偏置各异（Bagging 族、梯度提升树等）&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="layer1-box">
          <mxGeometry x="10" y="323" width="280" height="35" as="geometry"/>
        </mxCell>

        <!-- 概率向量 -->
        <mxCell id="pvec" value="&lt;b&gt;概率向量&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;p&lt;sub&gt;i,t&lt;/sub&gt; =&lt;br&gt;[p&lt;sup&gt;(1)&lt;/sup&gt;, …, p&lt;sup&gt;(N)&lt;/sup&gt;]&lt;sup&gt;T&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="230" width="130" height="110" as="geometry"/>
        </mxCell>

        <!-- 第二层 Attention 容器 -->
        <mxCell id="layer2-box" value="第二层：Attention 样本级融合" style="swimlane;startSize=28;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=12;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="90" width="300" height="390" as="geometry"/>
        </mxCell>

        <mxCell id="attn-step1" value="① 线性变换&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;W&lt;sub&gt;α&lt;/sub&gt;·p&lt;sub&gt;i,t&lt;/sub&gt; + b&lt;sub&gt;α&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;" vertex="1" parent="layer2-box">
          <mxGeometry x="30" y="50" width="240" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="attn-step2" value="② Softmax 归一化&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;α&lt;sub&gt;i,t&lt;/sub&gt;&lt;sup&gt;(m)&lt;/sup&gt;，Σ&lt;sub&gt;m&lt;/sub&gt;α = 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;" vertex="1" parent="layer2-box">
          <mxGeometry x="30" y="130" width="240" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="attn-step3" value="③ 加权凸组合&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ŷ&lt;sub&gt;i,t&lt;/sub&gt; = Σ&lt;sub&gt;m=1&lt;/sub&gt;&lt;sup&gt;N&lt;/sup&gt; α&lt;sup&gt;(m)&lt;/sup&gt;·p&lt;sup&gt;(m)&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;" vertex="1" parent="layer2-box">
          <mxGeometry x="30" y="210" width="240" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="attn-note" value="&lt;font style=&quot;font-size:10px;color:#555555&quot;&gt;样本自适应权重，可解释各专家贡献占比&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="layer2-box">
          <mxGeometry x="20" y="290" width="260" height="30" as="geometry"/>
        </mxCell>

        <!-- 输出 -->
        <mxCell id="output" value="&lt;b&gt;融合故障概率&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ŷ&lt;sub&gt;i,t&lt;/sub&gt; ∈ [0, 1]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="245" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- Focal Loss -->
        <mxCell id="focal" value="&lt;b&gt;Focal Loss&lt;/b&gt;  ℒ&lt;sub&gt;FL&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;对易分样本降权，强化少数类故障样本&lt;br&gt;在验证集上更新 W&lt;sub&gt;α&lt;/sub&gt;, b&lt;sub&gt;α&lt;/sub&gt;（γ=2）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
          <mxGeometry x="820" y="520" width="340" height="70" as="geometry"/>
        </mxCell>

        <!-- 标签 y -->
        <mxCell id="ylabel" value="标签 y&lt;sub&gt;i,t&lt;/sub&gt; ∈ {0,1}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="530" width="130" height="50" as="geometry"/>
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="515" width="200" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="legend-title" value="图例" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="52" y="520" width="40" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="legend1-line" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="52" y="548" as="sourcePoint"/>
            <mxPoint x="102" y="548" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend1" value="推理数据流" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="112" y="538" width="110" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend2-line" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#c62828;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="52" y="572" as="sourcePoint"/>
            <mxPoint x="102" y="572" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend2" value="训练 / 损失" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="112" y="562" width="110" height="20" as="geometry"/>
        </mxCell>

        <!-- ===== 连线：推理主路径（实线） ===== -->

        <!-- input -> M_1, M_N -->
        <mxCell id="e-in-m1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="input" target="m1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-in-mN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="input" target="mN">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-in-dots" value="⋯" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#999999;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=14;fontColor=#888888;" edge="1" parent="1" source="input" target="dots-mid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- M_1 / M_N -> p outputs -->
        <mxCell id="e-m1-out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#1565c0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m1" target="m1-out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-mN-out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#1565c0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mN" target="mN-out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- p outputs -> pvec -->
        <mxCell id="e-p1-pvec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3949ab;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="m1-out" target="pvec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-pN-pvec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3949ab;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="mN-out" target="pvec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- pvec -> attn step1 -->
        <mxCell id="e-pvec-attn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pvec" target="attn-step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- attn internal steps -->
        <mxCell id="e-attn-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#e65100;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="attn-step1" target="attn-step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-attn-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#e65100;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="attn-step2" target="attn-step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- attn step3 -> output -->
        <mxCell id="e-attn-out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="attn-step3" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== 连线：训练路径（虚线） ===== -->

        <!-- output -> focal -->
        <mxCell id="e-out-focal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#c62828;dashed=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="output" target="focal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ylabel -> focal -->
        <mxCell id="e-y-focal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#c62828;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ylabel" target="focal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- focal -> layer2 (update params) -->
        <mxCell id="e-focal-back" value="更新 W&lt;sub&gt;α&lt;/sub&gt;, b&lt;sub&gt;α&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#c62828;dashed=1;fontSize=10;exitX=0.25;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="focal" target="layer2-box">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
